<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Welcome to Skill Workshop</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f7f7f7;
        color: #333;
      }
      .container {
        max-width: 500px;
        margin: 40px auto;
        background: #fff;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      }
      .btn {
        display: inline-block;
        padding: 12px 24px;
        background: #007bff;
        color: #fff;
        text-decoration: none;
        border-radius: 4px;
        margin-top: 20px;
      }
      .footer {
        margin-top: 30px;
        font-size: 12px;
        color: #888;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h2>Welcome to Skill Workshop, <%= name %>!</h2>
      <p>Your account has been created successfully.</p>
      <p>You are now registered as a <strong><%= role %></strong>.</p>
      <p>
        Start exploring workshops, enroll in courses, and take your skills to
        the next level.
      </p>
      <a href="<%= dashboardLink %>" class="btn"> Go to Dashboard </a>
      <div class="footer">
        &copy; Skill Workshop Management System. All rights reserved.
      </div>
    </div>
  </body>
</html>
