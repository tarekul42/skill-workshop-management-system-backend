PORT=5000
NODE_ENV=development
DATABASE_URL=mongodb://localhost:27017/skill-workshop-management-system
BCRYPT_SALT_ROUND=12

# ── Secrets ──────────────────────────────────────────────────────────
# ALL secrets MUST be replaced with unique high-entropy random values.
# The app refuses to boot with short or placeholder secrets.
# Generate each one with:  openssl rand -hex 32
JWT_ACCESS_SECRET=REPLACE_WITH_openssl_rand_hex_32_output
JWT_ACCESS_EXPIRES=30m
JWT_REFRESH_SECRET=REPLACE_WITH_a_DIFFERENT_openssl_rand_hex_32_output
JWT_REFRESH_EXPIRES=7d
SUPER_ADMIN_EMAIL=admin@example.com
# Min 12 chars incl. upper, lower, digit, special. Weak values trigger a
# generated password printed once at first boot in non-production.
SUPER_ADMIN_PASSWORD=ChangeMe-Before-First-Run!2026
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
EXPRESS_SESSION_SECRET=REPLACE_WITH_openssl_rand_hex_32_output
FRONTEND_URL=http://localhost:3000
BACKEND_DEV_URL=http://localhost:5000
BACKEND_PROD_URL=https://your-domain.com
SSL_STORE_ID=your-ssl-store-id
SSL_STORE_PASS=your-ssl-store-password
SSL_PAYMENT_API=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSL_VALIDATION_API=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
SSL_IPN_URL=http://localhost:5000/api/v1/payment/validate-payment
SSL_SUCCESS_BACKEND_URL=http://localhost:5000/api/v1/payment/success
SSL_FAIL_BACKEND_URL=http://localhost:5000/api/v1/payment/fail
SSL_CANCEL_BACKEND_URL=http://localhost:5000/api/v1/payment/cancel
SSL_SUCCESS_FRONTEND_URL=http://localhost:3000/payment/success
SSL_FAIL_FRONTEND_URL=http://localhost:3000/payment/fail
SSL_CANCEL_FRONTEND_URL=http://localhost:3000/payment/cancel
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your-smtp-password
SMTP_PORT=465
SMTP_HOST=smtp.gmail.com
SMTP_FROM=noreply@example.com
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
CSRF_SECRET=REPLACE_WITH_openssl_rand_hex_32_output
RESET_PASSWORD_SECRET=REPLACE_WITH_openssl_rand_hex_32_output
METRICS_API_KEY=REPLACE_WITH_openssl_rand_hex_32_output
